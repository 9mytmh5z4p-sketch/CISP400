# macOS
.DS_Store

# Editors
.vscode/
.idea/

# Quarto and notebook artifacts
.quarto/
**/*.quarto_ipynb
**/*_files/
# Reveal.js lectures need their generated CSS and JavaScript support folders.
# Keep those assets for lecture directories so the HTML presentations work on GitHub Pages.
!p400_lecture_*/**/*_files/
!p400_lecture_*/**/*_files/**

# Local prior-lecture source materials
*.key
p400_lecture_*/**/*.pdf

# Temporary and backup files
*.bak
*.tmp
*.swp
*~
*.log

# R/Python caches, if created by tools
__pycache__/
.ipynb_checkpoints/

# Local environment files
.env
.env.*
!.env.example

/.quarto/
